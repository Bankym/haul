<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="index" appConnect="local" components="{dmxFormatter:{}}" -->
<meta name="ac:route" content="/">

<section class="container-fluid bg-primary-subtle py-5">
    <div class="row align-items-center justify-content-center">
        <div class="col-12 col-lg-7 text-center text-lg-start mb-4 mb-lg-0">
            <h1 class="display-4 fw-bold text-primary-emphasis mb-3">Fast, Reliable Delivery Solutions</h1>
            <p class="lead text-body">Connect your vehicle – motorbike, van, car, or truck – and start earning by helping businesses and individuals with pickups and deliveries. Need something delivered? Post your request and get matched instantly!</p>
            <div class="mt-4">
                <a href="/register" internal class="btn btn-primary btn-lg px-5 py-2 me-3 shadow">Get Started</a>
                <a href="/about" internal class="btn btn-outline-primary btn-lg px-4 py-2">Learn More</a>
            </div>
        </div>
        <div class="col-12 col-lg-5 text-center">
            <img src="/assets/images/delivery-hero.avif" alt="Vehicle Delivery Service" class="img-fluid" style="max-height:350px;object-fit:contain;" loading="lazy">
        </div>
    </div>
</section>

<section class="container py-5">
    <div class="row g-4">
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-motorcycle fa-2x text-primary"></i>
                    <h5 class="mt-3">For Vehicle Owners</h5>
                    <p class="text-body">Sign up, list your motorbike, van, car, or truck, and get matched with local delivery requests. Flexible, easy, great earning potential.</p>
                    <a href="/register" internal class="btn btn-primary btn-sm">Sign Up as Owner</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-box-open fa-2x text-primary"></i>
                    <h5 class="mt-3">For Senders</h5>
                    <p class="text-body">Need something picked up or delivered? Post your job and instantly connect with available vehicles nearby for quick, reliable service.</p>
                    <a href="/register" internal class="btn btn-outline-primary btn-sm">Sign Up as Sender</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-clock fa-2x text-primary"></i>
                    <h5 class="mt-3">How It Works</h5>
                    <p class="text-body">List your vehicle or delivery need, get matched through our smart platform, track progress and stay in touch – simple, seamless, secure.</p>
                    <a href="/about" internal class="btn btn-link text-decoration-none">Learn More</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-user-shield fa-2x text-primary"></i>
                    <h5 class="mt-3">Why Choose Us?</h5>
                    <p class="text-body">Fast support, trusted ratings, secure payments, and flexible deliveries that fit every schedule and budget. Experience the future of pickups and drop-offs!</p>
                </div>
            </div>
        </div>
    </div>
</section>